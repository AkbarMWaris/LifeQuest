# Copy this file to .env and fill in your values.

# MongoDB Atlas connection string (or any mongodb:// URI)
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/lifequest
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/lifequest

PORT=4000

# Secret used to sign access tokens — use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Where the client runs (used for CORS).
CLIENT_ORIGIN=http://localhost:5173